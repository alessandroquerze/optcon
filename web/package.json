{
  "name": "optcon-appunti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-sources.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-sources.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:inventory": "node scripts/check-inventory.mjs",
    "session": "node scripts/session.mjs"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "plotly.js-dist-min": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/plotly.js": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
